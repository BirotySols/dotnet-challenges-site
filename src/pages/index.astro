---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title=".NET Challenges — request-level practice"
  description="Intermediate ASP.NET Core practice for developers who already build CRUD APIs."
>
  <main id="main" class="home">
    <section class="intro">
      <div class="intro-copy-block">
        <p class="eyebrow">A catalog of request-level decisions</p>
        <h1>Practice the choices a template leaves to you.</h1>
        <p class="audience">
          Intermediate practice for developers who already build CRUD APIs.
        </p>
        <p class="intro-copy">
          Each challenge asks for one observable behavior. Clone the starter,
          make the decision, and let the local harness show whether its effects are there.
        </p>
      </div>
      <aside class="status-slip" aria-label="Example from the first challenge">
        <div class="slip-top">
          <span>Request trace</span>
          <span>01 / 04</span>
        </div>
        <code class="slip-route">POST /products</code>
        <pre><code>{`{ "name": " ", "quantity": 0 }`}</code></pre>
        <p class="slip-result">
          <span class="stamp">400</span>
          <span>problem names both fields</span>
        </p>
        <p class="slip-result">
          <span class="state-mark" aria-hidden="true">=</span>
          <span>stored product stays unchanged</span>
        </p>
      </aside>
    </section>

    <section class="available" aria-labelledby="available-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">First challenge</p>
          <h2 id="available-title">HTTP API contracts</h2>
        </div>
        <span class="sequence" aria-label="Sequence position 1 of 9">01 <span>/ 09</span></span>
      </div>
      <p class="available-copy">
        Decide what an invalid write means for the response and for the data already stored.
      </p>
      <a class="challenge-link" href={`${base}challenges/request-validation/`}>
        Read the challenge <span aria-hidden="true">→</span>
      </a>
    </section>

    <aside class="setup" aria-label="Setup">
      <div>
        <p class="section-kicker">What you need</p>
        <p>Git and the .NET SDK. You do not need Node to use the catalog.</p>
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  .home {
    padding-block: clamp(2.5rem, 7vw, 5rem) 2rem;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 22rem);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block-end: clamp(2.5rem, 6vw, 4.5rem);
  }

  .intro .eyebrow {
    margin: 0 0 1rem;
  }

  h1,
  h2,
  p {
    margin-block-start: 0;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: 1rem;
    font-family: var(--display);
    font-size: clamp(2.4rem, 5.4vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .audience {
    max-width: 36ch;
    margin-block-end: 0.65rem;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .intro-copy {
    max-width: 58ch;
    margin-block-end: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .available {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-inline-start: 4px solid var(--ink);
    background: var(--surface);
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .section-kicker {
    margin-block-end: 0.55rem;
  }

  h2 {
    margin-block-end: 0;
    font-family: var(--display);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .sequence {
    color: var(--pass);
    font-family: var(--mono);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .sequence span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .available-copy {
    max-width: 62ch;
    margin-block: 1rem 1.4rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .challenge-link {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    background: var(--action);
    color: white;
    font-family: var(--display);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease-out;
  }

  .challenge-link:hover {
    background: var(--action-hover);
    color: white;
  }

  .challenge-link:active {
    background: var(--pass);
  }

  .challenge-link span {
    transition: transform 180ms ease-out;
  }

  .challenge-link:hover span {
    transform: translateX(3px);
  }

  .setup {
    margin-block-start: 1.5rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    background: var(--mark);
  }

  .setup .section-kicker {
    margin-block-end: 0.35rem;
    color: var(--muted);
  }

  .setup p:last-child {
    margin-block-end: 0;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .status-slip {
      order: -1;
    }
  }

  @media (max-width: 520px) {
    .setup {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .challenge-link,
    .challenge-link span {
      transition: none;
    }
  }
</style>
