---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Familjen+Grotesk:wght@500;600;700&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label=".NET Challenges home">
          <span class="wordmark-mark" aria-hidden="true">DC</span>
          <span>.NET <strong>CHALLENGES</strong></span>
        </a>
        <span class="header-note">Request-level practice</span>
        <a class="header-link" href="https://github.com/mustafaAshfaq/dotnet-challenges">
          Exercise repository
        </a>
      </header>
      <slot />
      <footer class="site-footer">
        <span>Build the decision. Verify the effect.</span>
        <a href="https://github.com/BirotySols/dotnet-challenges-site">Catalog source</a>
      </footer>
    </div>
  </body>
</html>

<script>
  const openReveals = new Set<string>();
  const unlockedHints = new Set<string>();

  const restoreReveals = () => {
    const disclosures = document.querySelectorAll<HTMLDetailsElement>('[data-reveal]');

    for (const disclosure of disclosures) {
      const revealId = disclosure.dataset.reveal!;
      const hintNumber = Number(disclosure.dataset.hintNumber);
      const isOpen = openReveals.has(revealId);
      disclosure.open = isOpen;
      if (isOpen && hintNumber > 0) {
        unlockedHints.add(`hint-${hintNumber}`);
      }

      if (disclosure.dataset.bound === 'true') {
        continue;
      }

      disclosure.dataset.bound = 'true';
      disclosure.addEventListener('toggle', () => {
        if (disclosure.open) {
          openReveals.add(revealId);
          if (hintNumber > 0) {
            unlockedHints.add(`hint-${hintNumber}`);
          }
        } else {
          openReveals.delete(revealId);
        }

        updateHintGates();
      });
    }

    updateHintGates();
  };

  const updateHintGates = () => {
    for (const gate of document.querySelectorAll<HTMLElement>('[data-hint-gate]')) {
      const previousHint = Number(gate.dataset.hintGate) - 1;
      gate.hidden = !unlockedHints.has(`hint-${previousHint}`);
    }
  };

  document.addEventListener('astro:page-load', restoreReveals);
  document.addEventListener('astro:after-swap', () => {
    const main = document.getElementById('main');
    if (!main) return;
    main.tabIndex = -1;
    main.focus();
  });
  restoreReveals();
</script>

<style is:global>
  :root {
    color-scheme: light;
    --canvas: #eef3f0;
    --surface: #ffffff;
    --mark: #d7e6de;
    --well: #d5e0da;
    --ink: #14211c;
    --muted: #3c5149;
    --line: #c5d2cb;
    --action: #14211c;
    --action-hover: #24352f;
    --fail: #7f1d1d;
    --pass: #0f5c4c;
    --mono: "Fragment Mono", "Cascadia Code", ui-monospace, monospace;
    --body: "Atkinson Hyperlegible", "Segoe UI", sans-serif;
    --display: "Familjen Grotesk", "Avenir Next", sans-serif;
    font-family: var(--body);
    color: var(--ink);
    background: var(--canvas);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--canvas);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
  }

  a {
    color: var(--pass);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
    touch-action: manipulation;
  }

  a:hover {
    color: var(--ink);
  }

  :focus-visible {
    outline: 3px solid var(--fail);
    outline-offset: 3px;
  }

  button,
  summary {
    font: inherit;
    touch-action: manipulation;
    cursor: pointer;
  }

  .site-shell {
    width: min(100% - 2.5rem, 76rem);
    margin-inline: auto;
  }

  .skip-link {
    position: absolute;
    z-index: 10;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    transform: translateY(-160%);
    padding: 0.65rem 0.9rem;
    background: var(--ink);
    color: white;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    min-height: 5.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    flex: none;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .wordmark-mark {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fail);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: -0.06em;
  }

  .wordmark strong {
    font-weight: 700;
  }

  .header-note,
  .header-link {
    font-size: 0.92rem;
  }

  .header-note {
    color: var(--muted);
  }

  .header-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    margin-block-start: 4rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.84rem;
  }

  .site-footer a {
    font-weight: 650;
  }

  .eyebrow,
  .section-kicker,
  .mono-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow,
  .section-kicker {
    color: var(--pass);
  }

  .status-slip {
    max-width: 100%;
    min-width: 0;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid var(--line);
    border-top: 4px solid var(--fail);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .slip-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .slip-route {
    display: block;
    margin: 0 0 0.55rem;
    color: var(--ink);
  }

  .status-slip pre {
    max-width: 100%;
    overflow-x: auto;
    margin: 0;
    padding: 0.85rem;
    background: var(--well);
    color: var(--ink);
    white-space: pre-wrap;
  }

  .slip-result {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    padding-block-start: 0.85rem;
    color: var(--ink);
  }

  .stamp {
    min-width: 2.75rem;
    min-height: 1.5rem;
    display: inline-grid;
    place-items: center;
    padding: 0.12rem 0.4rem;
    background: var(--fail);
    color: white;
    font-weight: 400;
  }

  .state-mark {
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    flex: none;
    place-items: center;
    border: 1px solid var(--pass);
    border-radius: 50%;
    color: var(--pass);
    font-weight: 400;
  }

  @media (max-width: 650px) {
    .site-shell {
      width: min(100% - 1.5rem, 76rem);
    }

    .site-header {
      min-height: 4.5rem;
    }

    .header-note {
      display: none;
    }

    .header-link {
      font-size: 0.78rem;
      text-align: right;
    }

    .site-footer {
      flex-direction: column;
      margin-block-start: 2.5rem;
    }
  }
</style>
